# Kaggle credentials for database/fetch_data.py. Copy to .env and fill in.
# .env is gitignored and must never be committed.

# Preferred: from kaggle.json (kaggle.com -> Settings -> API -> Create New API Token)
KAGGLE_USERNAME=
KAGGLE_KEY=

# Alternative: the full Cookie header value from a logged-in kaggle.com request.
# Broader scope than the API token and expires sooner, so prefer the token above.
KAGGLE_COOKIE=
